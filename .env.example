# --- Core -------------------------------------------------------------------
# REQUIRED in production — the app refuses to boot without it (no insecure
# fallback). Generate with: openssl rand -base64 32
PAYLOAD_SECRET=your_payload_secret_here

# --- Database (Supabase) -----------------------------------------------------
# Runtime / serverless connection: Supabase TRANSACTION POOLER, port 6543.
# Get this from Supabase dashboard → Connect → Transaction pooler.
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.PROJECT_REF:password@aws-0-REGION.pooler.supabase.com:6543/postgres

# For running migrations ONLY (e.g. `payload migrate`): the SESSION pooler,
# port 5432 (IPv4). The runtime pool NEVER reads this — it always uses
# DATABASE_URL above. To migrate, run the command with DATABASE_URL set to this.
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL_DIRECT=postgresql://postgres.PROJECT_REF:password@aws-0-REGION.pooler.supabase.com:5432/postgres

# Max pool connections PER serverless instance. 1 is too low for the admin
# panel's concurrent queries (causes pool-acquire timeouts); 3 is a safe default.
DB_POOL_MAX=3

# Dev schema-push: syncs the DB schema to collections on boot. Leave false in
# serverless/production — use migrations instead.
# PAYLOAD_DB_PUSH=true

# --- Admin bootstrap (opt-in) ------------------------------------------------
# The seed admin accounts are created ONLY when PAYLOAD_SEED_ADMINS=true AND a
# password is supplied below. Leave unset in production — after migration these
# users already exist in the database. Use only to bootstrap an empty DB.
# PAYLOAD_SEED_ADMINS=true
# SEED_SUPER_ADMIN_PASSWORD=
# SEED_ADMIN_PASSWORD=

# Public base URL. Used for canonical + hreflang tags, so it MUST be the real
# origin in production (no trailing slash).
#   local:      http://localhost:3000
#   production: https://te1-steel.vercel.app
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000

# --- Media storage (optional) ------------------------------------------------
# When set, uploads go to Vercel Blob instead of local disk.
BLOB_READ_WRITE_TOKEN=

# --- SMTP Email Configuration ------------------------------------------------
# Without SMTP_HOST, Payload logs emails to the console instead of sending them.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
EMAIL_FROM_ADDRESS=your_email@gmail.com
EMAIL_FROM_NAME="Team Eyrie"
